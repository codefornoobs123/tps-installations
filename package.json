{
  "name": "tps-installations-website",
  "version": "1.0.0",
  "private": true,
  "description": "TPS Installations — content-driven static site. All copy lives in content.json.",
  "scripts": {
    "start": "node tools/preflight.js && eleventy --serve --quiet",
    "dev": "eleventy --serve",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "prebuild": "node tools/preflight.js",
    "build": "npm run clean && eleventy",
    "check": "node tools/check.js && node tools/check-cms.js",
    "verify": "npm run build && npm run check",
    "fonts": "node tools/fetch-fonts.js",
    "preview": "npm run build && node tools/make-preview.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^7.0.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.51.2"
  }
}
