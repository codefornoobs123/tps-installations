{%- if tps.strip.items.length %}
<section class="strip" aria-label="What we do">
  <div class="strip__track">
    {#- Rendered twice so the marquee can loop without a visible seam. The
        duplicate is hidden from assistive tech. -#}
    <ul>
      {%- for item in tps.strip.items %}
      <li><span>{{ item }}</span></li>
      {%- endfor %}
    </ul>
    <ul aria-hidden="true">
      {%- for item in tps.strip.items %}
      <li><span>{{ item }}</span></li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}
