{#- Job-type icons for the quote form chips. Picked by keyword so a renamed
    option in the CMS still gets the right picture; anything unknown gets
    the plain house. All line icons, 24 grid, currentColor. -#}
{% macro jobIcon(label) %}{%- set k = label | lower -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if "extension" in k -%}<path d="M3 20V10l6-5 6 5v10"/><path d="M15 12h6v8h-6"/><path d="M3 20h18"/><path d="M7.5 20v-5h3v5"/><path d="M18 3v4M16 5h4"/>
{%- elif "driveway" in k or "patio" in k or "paving" in k -%}<path d="M3 20 8 4h8l5 16Z"/><path d="M5.5 12h13M4.2 16h15.6M10 4l-1.5 8M14 4l1.5 8M9.2 12 8 20M14.8 12 16 20"/>
{%- elif "roof" in k -%}<path d="M2 13 12 4l10 9"/><path d="M5 10.5 12 5l7 5.5"/><path d="M5 12v8h14v-8"/><path d="M16 6V3.5h2.5V8"/>
{%- elif "ground" in k -%}<path d="M3 9h18"/><path d="M3 14h18M3 19h18" stroke-dasharray="2 2.5"/><path d="M12 9V3M9 6l3-3 3 3"/>
{%- elif "brick" in k -%}<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 9.7h18M3 14.3h18M9 5v4.7M15 5v4.7M6 9.7v4.6M12 9.7v4.6M18 9.7v4.6M9 14.3V19M15 14.3V19"/>
{%- elif "render" in k or "plaster" in k -%}<path d="M4 15h11l3-3H7Z"/><path d="M11.5 15v2.5a1.5 1.5 0 0 1-1.5 1.5H9"/><path d="M5 8c3-1.5 6 1.5 9 0s4-1 6 0"/>
{%- elif "renovation" in k -%}<path d="M3 20V10l9-7 9 7v10Z"/><path d="m9 15 2 2 4-4"/>
{%- elif "kitchen" in k -%}<rect x="3" y="11" width="18" height="9" rx="1"/><path d="M12 11v9M7 14h2M15 14h2"/><path d="M6 11V7h4v4M17 11V4"/>
{%- elif "bath" in k -%}<path d="M3 12h18v3a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5Z"/><path d="M6 12V5.5A2.5 2.5 0 0 1 10.5 4"/><path d="M7 20l-1 1.5M17 20l1 1.5"/>
{%- elif "loft" in k -%}<path d="M2 14 12 4l10 10"/><path d="M5 11v9h14v-9"/><rect x="9.5" y="9" width="5" height="4" rx=".5"/>
{%- elif "garage" in k -%}<path d="M3 20V9l9-5 9 5v11"/><path d="M6.5 20v-8h11v8M6.5 15h11"/>
{%- elif "not sure" in k or "unsure" in k -%}<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.8-.9 1.4v.6"/><path d="M12 17h.01"/>
{%- else -%}<path d="M3 20V10l9-7 9 7v10Z"/><path d="M9.5 20v-6h5v6"/>
{%- endif -%}</svg>{% endmacro %}
{% macro timeIcon(label) %}{%- set k = label | lower -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if "morning" in k -%}<path d="M3 18h18M7 18a5 5 0 0 1 10 0"/><path d="M12 5v3M4.9 9.9l2 2M19.1 9.9l-2 2"/>
{%- elif "evening" in k or "night" in k -%}<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/>
{%- else -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/>
{%- endif -%}</svg>{% endmacro %}
{% macro quote() %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg>{% endmacro %}
