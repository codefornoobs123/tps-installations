{#- ---------------------------------------------------------------------------
    JSON-LD. Every value comes from content.json — nothing is written by hand.
    LocalBusiness appears on every page as the NAP anchor. Service, FAQPage and
    BreadcrumbList are added per page type via the `schemaType` front matter.
--------------------------------------------------------------------------- -#}
{%- set base = tps.derived.siteUrl -%}
{%- set bizId = base + "/#business" -%}

{%- set hours = [] -%}
{%- for h in tps.contact.openingHours -%}
  {%- if h.schema -%}{%- set hours = (hours.push(h.schema), hours) -%}{%- endif -%}
{%- endfor -%}

{%- set sameAs = [] -%}
{%- for key, val in tps.social -%}
  {%- if val -%}{%- set sameAs = (sameAs.push(val), sameAs) -%}{%- endif -%}
{%- endfor -%}
{%- if tps.contact.googleBusinessProfileUrl and "TPS_" not in tps.contact.googleBusinessProfileUrl -%}
  {%- set sameAs = (sameAs.push(tps.contact.googleBusinessProfileUrl), sameAs) -%}
{%- endif -%}

{%- set areaServed = [] -%}
{%- for a in tps.areas -%}
  {%- set areaServed = (areaServed.push({ "@type": "City", "name": a.name }), areaServed) -%}
{%- endfor -%}

{%- set business = {
  "@type": "LocalBusiness",
  "@id": bizId,
  "name": tps.site.name,
  "legalName": tps.site.legalName,
  "description": tps.site.tagline,
  "url": base + "/",
  "telephone": tps.contact.phoneDisplay,
  "email": tps.contact.email,
  "image": base + tps.site.defaultOgImage,
  "logo": base + tps.site.logo,
  "priceRange": "££",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": tps.contact.address.street,
    "addressLocality": tps.contact.address.locality,
    "addressRegion": tps.contact.address.region,
    "postalCode": tps.contact.address.postcode,
    "addressCountry": tps.contact.address.country
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": tps.contact.geo.latitude,
    "longitude": tps.contact.geo.longitude
  },
  "openingHours": hours,
  "sameAs": sameAs,
  "areaServed": areaServed
} -%}

{%- set graph = [] -%}
{%- set graph = (graph.push(business), graph) -%}

{#- WebSite -#}
{%- set graph = (graph.push({
  "@type": "WebSite",
  "@id": base + "/#website",
  "url": base + "/",
  "name": tps.site.name,
  "publisher": { "@id": bizId },
  "inLanguage": tps.site.language
}), graph) -%}

{#- Organization. Distinct from LocalBusiness: this is the legal entity that
    Google associates with the brand, logo and social profiles. -#}
{%- set graph = (graph.push({
  "@type": "Organization",
  "@id": base + "/#organization",
  "name": tps.site.legalName or tps.site.name,
  "url": base + "/",
  "logo": {
    "@type": "ImageObject",
    "url": base + tps.site.logo,
    "caption": tps.site.logoAlt
  },
  "telephone": tps.contact.phoneDisplay,
  "email": tps.contact.email,
  "sameAs": sameAs
}), graph) -%}

{#- Reviews. Only emitted for testimonials with real copy — review markup on
    invented reviews is both a Google penalty and, in the UK, a civil offence
    under the DMCC Act 2024. -#}
{%- set realReviews = [] -%}
{%- for t in tps.testimonials -%}
  {%- if t.quote and "[" not in t.quote and t.name and "[" not in t.name -%}
    {%- set realReviews = (realReviews.push(t), realReviews) -%}
  {%- endif -%}
{%- endfor -%}
{%- if realReviews.length -%}
  {%- set reviewNodes = [] -%}
  {%- set ratingTotal = 0 -%}
  {%- for t in realReviews -%}
    {%- set ratingTotal = ratingTotal + (t.rating or 5) -%}
    {%- set reviewNodes = (reviewNodes.push({
      "@type": "Review",
      "itemReviewed": { "@id": bizId },
      "author": { "@type": "Person", "name": t.name },
      "reviewRating": { "@type": "Rating", "ratingValue": t.rating or 5, "bestRating": 5 },
      "reviewBody": t.quote,
      "datePublished": t.date
    }), reviewNodes) -%}
  {%- endfor -%}
  {%- for r in reviewNodes -%}{%- set graph = (graph.push(r), graph) -%}{%- endfor -%}
  {%- set graph = (graph.push({
    "@type": "AggregateRating",
    "itemReviewed": { "@id": bizId },
    "ratingValue": (ratingTotal / realReviews.length) | round(1),
    "reviewCount": realReviews.length,
    "bestRating": 5
  }), graph) -%}
{%- endif -%}

{#- Breadcrumbs -#}
{%- if crumbs and crumbs.length -%}
  {%- set items = [] -%}
  {%- set pos = 0 -%}
  {%- for c in crumbs -%}
    {%- set pos = pos + 1 -%}
    {%- set items = (items.push({ "@type": "ListItem", "position": pos, "name": c.label, "item": base + c.url }), items) -%}
  {%- endfor -%}
  {%- set graph = (graph.push({ "@type": "BreadcrumbList", "itemListElement": items }), graph) -%}
{%- endif -%}

{#- Service pages -#}
{%- if schemaType == "service" and service -%}
  {%- set graph = (graph.push({
    "@type": "Service",
    "@id": base + service.url + "#service",
    "name": service.name,
    "description": service.intro,
    "serviceType": service.name,
    "provider": { "@id": bizId },
    "areaServed": areaServed,
    "url": base + service.url
  }), graph) -%}
{%- endif -%}

{#- Town + service landing pages -#}
{%- if schemaType == "location" and loc -%}
  {%- set graph = (graph.push({
    "@type": "Service",
    "@id": base + loc.url + "#service",
    "name": loc.h1,
    "description": loc.seo.description,
    "serviceType": loc.service.name,
    "provider": { "@id": bizId },
    "areaServed": { "@type": "City", "name": loc.area.name, "containedInPlace": { "@type": "AdministrativeArea", "name": loc.area.county } },
    "url": base + loc.url
  }), graph) -%}
{%- endif -%}

{#- FAQPage -#}
{%- if faqItems and faqItems.length -%}
  {%- set qs = [] -%}
  {%- for f in faqItems -%}
    {%- set qs = (qs.push({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }), qs) -%}
  {%- endfor -%}
  {%- set graph = (graph.push({
    "@type": "FAQPage",
    "@id": base + page.url + "#faq",
    "mainEntity": qs
  }), graph) -%}
{%- endif -%}

<script type="application/ld+json">{{ { "@context": "https://schema.org", "@graph": graph } | jsonld | safe }}</script>
