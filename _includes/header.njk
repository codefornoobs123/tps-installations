{% from "icons.njk" import phone %}
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-logo" href="/">
      {#- Logo lockup, matching TPS's own logo (tpsinstallations.co.uk): the
          house mark traced from it in brand brown, "T.P.S." and "INSTALLATIONS
          LIMITED" underneath. Swap in the printer's vector file if it turns up. -#}
      <img src="{{ tps.site.logo }}" alt="" width="52" height="40" fetchpriority="high">
      <span class="visually-hidden">{{ tps.site.name }}, home</span>
      <span class="site-logo__words" aria-hidden="true">
        <b class="site-logo__text">T.P.S.</b>
        <span class="site-logo__sub">Installations Limited</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <nav class="site-nav" id="site-nav" data-open="false" aria-label="Main">
      <ul>
        {%- for item in tps.nav.primary %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
      <a class="btn btn--primary btn--block" href="{{ tps.cta.primaryUrl }}">{{ tps.cta.primaryLabel }}</a>
    </nav>

    <div class="header-cta">
      <a class="header-phone" href="{{ tps.derived.telHref }}">{{ phone() }}<span>{{ tps.contact.phoneDisplay }}</span></a>
      <a class="btn btn--primary" href="{{ tps.cta.primaryUrl }}">{{ tps.cta.primaryLabel }}</a>
    </div>
  </div>
</header>
