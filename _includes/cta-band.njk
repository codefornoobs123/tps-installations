{% from "icons.njk" import phone %}
<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{{ ctaHeading or tps.cta.bandHeading }}</h2>
      <p>{{ ctaBody or tps.cta.bandBody }}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href="{{ tps.cta.primaryUrl }}">{{ tps.cta.primaryLabel }}</a>
      <a class="btn btn--on-dark" href="{{ tps.derived.telHref }}">{{ phone() }} {{ tps.contact.phoneDisplay }}</a>
    </div>
  </div>
</section>
