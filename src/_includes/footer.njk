{% from "icons.njk" import phone, mail, pin, facebook, instagram, linkedin, youtube, tiktok, x %}
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <div>
        <h2 class="visually-hidden">{{ tps.site.name }}</h2>
        <a class="footer-logo" href="/" aria-label="{{ tps.site.name }}, home">
          <img src="/assets/img/logo-mark.svg" alt="" width="52" height="40" loading="lazy">
          <span aria-hidden="true"><b>T.P.S.</b><small>Installations Limited</small></span>
          {%- if tps.site.strapline %}<em class="footer-logo__strap" aria-hidden="true">{{ tps.site.strapline }}</em>{% endif %}
        </a>
        <p>{{ tps.site.tagline }}</p>
        {%- if tps.derived.hasSocial %}
        <div class="social-row">
          {% if tps.social.facebook %}<a href="{{ tps.social.facebook }}" target="_blank" rel="noopener" aria-label="{{ tps.site.name }} on Facebook">{{ facebook() }}</a>{% endif %}
          {% if tps.social.instagram %}<a href="{{ tps.social.instagram }}" target="_blank" rel="noopener" aria-label="{{ tps.site.name }} on Instagram">{{ instagram() }}</a>{% endif %}
          {% if tps.social.linkedin %}<a href="{{ tps.social.linkedin }}" target="_blank" rel="noopener" aria-label="{{ tps.site.name }} on LinkedIn">{{ linkedin() }}</a>{% endif %}
          {% if tps.social.youtube %}<a href="{{ tps.social.youtube }}" target="_blank" rel="noopener" aria-label="{{ tps.site.name }} on YouTube">{{ youtube() }}</a>{% endif %}
          {% if tps.social.tiktok %}<a href="{{ tps.social.tiktok }}" target="_blank" rel="noopener" aria-label="{{ tps.site.name }} on TikTok">{{ tiktok() }}</a>{% endif %}
          {% if tps.social.x %}<a href="{{ tps.social.x }}" target="_blank" rel="noopener" aria-label="{{ tps.site.name }} on X">{{ x() }}</a>{% endif %}
        </div>
        {%- endif %}
      </div>

      <div>
        <h3>Services</h3>
        <ul>
          {%- for s in tps.services %}
          <li><a href="{{ s.url }}">{{ s.name }}</a></li>
          {%- endfor %}
          <li><a href="/gallery/">Our work</a></li>
        </ul>
      </div>

      <div>
        <h3>Areas we cover</h3>
        <ul>
          {%- for a in tps.areas %}
          <li><a href="{{ a.url }}">{{ a.name }}</a></li>
          {%- endfor %}
          <li><a href="/areas/">All areas</a></li>
        </ul>
      </div>

      <div>
        <h3>Contact</h3>
        {# NAP — this block, the schema and the Google Business Profile must match exactly. #}
        <address>
          <p><a href="{{ tps.derived.telHref }}">{{ phone() }} {{ tps.contact.phoneDisplay }}</a></p>
          {%- if tps.contact.email %}<p><a href="mailto:{{ tps.contact.email }}">{{ mail() }} {{ tps.contact.email }}</a></p>{% endif %}
          <p>{{ pin() }} {{ tps.derived.addressLine }}</p>
        </address>
        <h3 style="margin-top:var(--sp-5)">Opening hours</h3>
        <ul>
          {%- for h in tps.contact.openingHours %}
          <li>{{ h.days }}: {{ h.hours }}</li>
          {%- endfor %}
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <p style="margin:0">
        &copy; {% if tps.site.copyrightStartYear and (tps.site.copyrightStartYear | string) != (tps.derived.currentYear | string) %}{{ tps.site.copyrightStartYear }}-{% endif %}{{ tps.derived.currentYear }} {{ tps.site.legalName }}.
        {#- The registration details (company number, registered office, VAT)
            are a legal must for the website, but moved off the footer at
            Josh's request: they're on /contact/ and /privacy/ via
            company-details.njk. The "Company details" link below goes there. -#}
      </p>
      <ul>
        {%- for item in tps.nav.footerLegal %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
        {%- if tps.analytics.provider == "ga4" and tps.analytics.ga4MeasurementId %}
        <li><button class="footer-link-btn" type="button" data-consent-open>{{ tps.analytics.consent.settingsLabel }}</button></li>
        {%- endif %}
      </ul>
    </div>
  </div>
</footer>
