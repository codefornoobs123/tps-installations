{#- Context: itemHeading (optional, default "h3") — drop to "h4" where this sits
    underneath an h3 sub-heading rather than directly under the section h2. -#}
{%- set hl = itemHeading if itemHeading else "h3" -%}
<div class="credentials">
  {%- for c in tps.trust.credentials %}
  <div class="credential">
    <{{ hl }}>{{ c.title }}</{{ hl }}>
    <p>{{ c.body }}</p>
    {%- if c.flag %}<p><span class="ph-flag">{{ c.flag }}</span></p>{% endif %}
  </div>
  {%- endfor %}
</div>
{%- if tps.trust.accreditations.length %}
<div class="badge-row">
  {%- for b in tps.trust.accreditations %}
    {%- if b.url %}<a href="{{ b.url }}" target="_blank" rel="noopener">{% endif -%}
    {% image b.logo, b.alt, "120px" %}
    {%- if b.url %}</a>{% endif -%}
  {%- endfor %}
</div>
{%- endif %}
