{#- /areas/: a coverage map beside the town cards (Josh, 2026-09-27: make
    this section more visually appealing). Positions and miles come from
    each town's lat/lng via the mapPoint filter, measured from contact.geo
    (the Ferndown base), straight line. The cards are the accessible way
    in; the map's pins are extra (hidden from screen readers, not tabbable)
    and light up with their card on hover (main.js). -#}
{%- set base = tps.contact.geo %}
{%- set A = tps.pages.areas %}
<div class="coverage">
  <figure class="coverage__map" data-reveal>
    <svg viewBox="0 0 600 480" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="covGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#D98B74" stop-opacity=".22"/>
          <stop offset="1" stop-color="#D98B74" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <circle cx="300" cy="215" r="300" fill="url(#covGlow)"/>
      {#- distance rings: 26px to the mile -#}
      {%- for r in [4, 8, 12] %}
      <circle class="cov-ring" cx="300" cy="215" r="{{ r * 26 }}" style="--i: {{ loop.index0 }}"/>
      {%- if 300 + r * 26 < 540 %}<text class="cov-ring__label" x="{{ 300 + r * 26 + 5 }}" y="211">{{ r }} miles</text>{% endif %}
      {%- endfor %}
      <g class="cov-north" transform="translate(560 40)"><path d="M0 -16 L7 6 L0 1 L-7 6 Z"/><text y="24" text-anchor="middle">N</text></g>

      {#- other towns we cover: small dots -#}
      {%- for t in A.alsoCovered %}{% set pt = t | mapPoint(base) %}{% if pt %}
      <g class="cov-also">
        <circle cx="{{ pt.x }}" cy="{{ pt.y }}" r="4"/>
        <text x="{{ pt.x + (10 if pt.x < 480 else -10) }}" y="{{ pt.y + 4 }}" text-anchor="{{ 'start' if pt.x < 480 else 'end' }}">{{ t.name }}</text>
      </g>
      {%- endif %}{% endfor %}

      {#- main towns: a line out from the base, then the pin -#}
      {%- for a in tps.areas %}{% set pt = a | mapPoint(base) %}{% if pt and pt.miles > 0 %}
      <line class="cov-spoke" data-area="{{ a.slug }}" x1="300" y1="215" x2="{{ pt.x }}" y2="{{ pt.y }}"/>
      {%- endif %}{% endfor %}
      {%- for a in tps.areas %}{% set pt = a | mapPoint(base) %}{% if pt and pt.miles > 0 %}
      <a href="{{ a.url }}" tabindex="-1" class="cov-pin" data-area="{{ a.slug }}">
        <circle class="cov-pin__hit" cx="{{ pt.x }}" cy="{{ pt.y }}" r="24" fill="transparent"/>
        <circle class="cov-pin__halo" cx="{{ pt.x }}" cy="{{ pt.y }}" r="16"/>
        <circle class="cov-pin__dot" cx="{{ pt.x }}" cy="{{ pt.y }}" r="8"/>
        {%- set left = pt.x < 300 %}
        <text x="{{ pt.x + (-16 if left else 16) }}" y="{{ pt.y + 5 }}" text-anchor="{{ 'end' if left else 'start' }}">{{ a.name }}</text>
      </a>
      {%- endif %}{% endfor %}

      {#- the base -#}
      <g class="cov-base">
        <circle class="cov-base__pulse" cx="300" cy="215" r="14"/>
        <circle class="cov-base__pulse cov-base__pulse--2" cx="300" cy="215" r="14"/>
        <circle class="cov-base__dot" cx="300" cy="215" r="11"/>
        <path d="M300 208.5l-6.5 5.5v6.5h4.5v-4h4v4h4.5v-6.5z" fill="#FFF"/>
        <text x="300" y="247" text-anchor="middle">Ferndown</text>
        <text class="cov-base__sub" x="300" y="263" text-anchor="middle">Our base</text>
      </g>
    </svg>
    <figcaption>
      <b>{{ A.mapHeading or "Where we work" }}</b>
      {%- if A.mapIntro %}<span>{{ A.mapIntro }}</span>{% endif %}
    </figcaption>
  </figure>

  <ul class="coverage__cards" data-reveal-group>
    {%- for a in tps.areas %}{% set pt = a | mapPoint(base) %}
    <li class="cov-card" data-area="{{ a.slug }}" data-reveal>
      <div class="cov-card__head">
        <h2 class="cov-card__name"><a href="{{ a.url }}">{{ a.name }}</a></h2>
        <span class="cov-card__miles">{% if pt and pt.miles > 0 %}{{ pt.miles }} miles away{% else %}Our base{% endif %}</span>
      </div>
      <p class="cov-card__meta">{{ a.county }}{% if a.postcodes %} &middot; {{ a.postcodes }}{% endif %}</p>
      <ul class="cov-card__links">
        {%- for lp in tps.locationPages %}{% if lp.area.slug == a.slug %}
        <li><a href="{{ lp.url }}">{{ lp.service.shortName or lp.service.name }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
      <a class="cov-card__more" href="{{ a.url }}">{{ a.name }} area guide <span aria-hidden="true">&rarr;</span></a>
    </li>
    {%- endfor %}
  </ul>
</div>
{%- if A.alsoCovered and A.alsoCovered.length %}
<p class="coverage__also"><b>{{ A.alsoHeading or "Also covered" }}:</b> {% for t in A.alsoCovered %}{{ t.name }}{% if not loop.last %}, {% endif %}{% endfor %}, and the villages in between.</p>
{%- endif %}
