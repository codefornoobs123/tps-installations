{#- Short quote form. Netlify Forms + honeypot.
    Usage: {% include "quote-form.njk" %}
    Optional context vars: formId (unique per instance), formHeading, prefillJob

    Interactive layer (2026-09-27), all progressive enhancement:
      * three steps (the job, the property, your details) with Next / Back;
        with JS off all three show as one long form and it still submits
      * job type and best time to call are real radio buttons styled as tap
        chips, so they work with no JS and with the keyboard (arrow keys)
      * a progress bar fills as the three required fields become valid
      * phone and postcode are tidied and checked as you type (main.js)
    With JS off it is a plain working form. -#}
{%- from "icons.njk" import jobIcon, timeIcon -%}
{%- set fid = formId or "quote" -%}
{#- The job buttons ARE the site's services (their short names), plus any
    extra options from form.jobTypes (e.g. "Not sure yet"), so the form always
    matches what the site offers. On a service or town+service page,
    prefillService (the service slug) ticks that page's service in advance. -#}
{%- set pre = prefillService or "" -%}
<div class="quote-form" data-quote-form>
  <div class="qf-progress" aria-hidden="true"><span class="qf-progress__bar"></span></div>
  {#- compactHead: the page already shows this heading and intro right next
      to the form, so the card keeps them for screen readers only. -#}
  {%- if compactHead %}
  <h2 class="visually-hidden" id="{{ fid }}-heading">{{ formHeading or tps.form.heading }}</h2>
  {%- else %}
  <h2 id="{{ fid }}-heading">{{ formHeading or tps.form.heading }}</h2>
  <p class="quote-form__intro">{{ tps.form.intro }}</p>
  {%- endif %}

  <form name="quote" method="POST" data-netlify="true" data-netlify-honeypot="company-website" data-netlify-recaptcha="true" action="/thanks/" aria-labelledby="{{ fid }}-heading">
    <input type="hidden" name="form-name" value="quote">
    <input type="hidden" name="page-source" value="{{ page.url }}">

    {#- Honeypot. Hidden from people, irresistible to bots. -#}
    <p class="hp-field" aria-hidden="true">
      <label for="{{ fid }}-company-website">Do not fill this in</label>
      <input id="{{ fid }}-company-website" name="company-website" type="text" tabindex="-1" autocomplete="off">
    </p>

    {#- THREE STEPS. With JS off (or before main.js runs) all three are
        simply shown one after another as a normal long form. main.js hides
        all but the current one and wires up Next / Back. -#}
    <div class="qf-status" aria-live="polite" data-counter="{{ tps.form.stepCounter }}">
      <span class="qf-status__count"></span>
    </div>

    {#- ── Step 1: the job ── -#}
    <section class="qf-step" data-step="1" aria-labelledby="{{ fid }}-s1">
      <h3 class="qf-step__title" id="{{ fid }}-s1" tabindex="-1">{{ tps.form.steps.job }}</h3>
      <fieldset class="field chips chips--jobs" data-pick-message="{{ tps.form.pickJobMessage }}">
        <legend>{{ tps.form.labels.jobType }}</legend>
        <div class="chips__grid">
          {%- for s in tps.services %}
          {%- set label = s.shortName or s.name %}
          <label class="chip">
            <input type="radio" name="job-type" value="{{ label }}"{% if pre == s.slug %} checked{% endif %}>
            <span class="chip__face">{{ jobIcon(label) | safe }}<span class="chip__text">{{ label }}</span></span>
          </label>
          {%- endfor %}
          {%- for j in tps.form.jobTypes %}
          <label class="chip">
            <input type="radio" name="job-type" value="{{ j }}">
            <span class="chip__face">{{ jobIcon(j) | safe }}<span class="chip__text">{{ j }}</span></span>
          </label>
          {%- endfor %}
        </div>
      </fieldset>
      <div class="qf-nav">
        <button class="btn btn--primary qf-next" type="button" data-next>{{ tps.form.nextLabel }}<svg class="qf-submit__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </div>
    </section>

    {#- ── Step 2: the property ── -#}
    <section class="qf-step" data-step="2" aria-labelledby="{{ fid }}-s2">
      <h3 class="qf-step__title" id="{{ fid }}-s2" tabindex="-1">{{ tps.form.steps.property }}</h3>
      <div class="field">
        <label for="{{ fid }}-postcode">{{ tps.form.labels.postcode }} <span class="req" aria-hidden="true">*</span></label>
        <input id="{{ fid }}-postcode" name="postcode" type="text" autocomplete="postal-code" autocapitalize="characters" spellcheck="false" maxlength="10" required data-track data-kind="postcode">
      </div>
      <div class="field">
        <label for="{{ fid }}-message">{{ tps.form.labels.message }} <span class="opt">{{ tps.form.labels.optional }}</span></label>
        <textarea id="{{ fid }}-message" name="message" rows="3" data-autogrow></textarea>
      </div>
      <div class="qf-nav">
        <button class="btn btn--secondary qf-back" type="button" data-back><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg><span class="visually-hidden">{{ tps.form.backLabel }}</span></button>
        <button class="btn btn--primary qf-next" type="button" data-next>{{ tps.form.nextLabel }}<svg class="qf-submit__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </div>
    </section>

    {#- ── Step 3: your details ── -#}
    <section class="qf-step" data-step="3" aria-labelledby="{{ fid }}-s3">
      <h3 class="qf-step__title" id="{{ fid }}-s3" tabindex="-1">{{ tps.form.steps.details }}</h3>
      <div class="field">
        <label for="{{ fid }}-name">{{ tps.form.labels.name }} <span class="req" aria-hidden="true">*</span></label>
        <input id="{{ fid }}-name" name="name" type="text" autocomplete="name" autocapitalize="words" required data-track>
      </div>
      <div class="field">
        <label for="{{ fid }}-phone">{{ tps.form.labels.phone }} <span class="req" aria-hidden="true">*</span></label>
        <input id="{{ fid }}-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required data-track data-kind="phone">
      </div>

      {%- if tps.form.callTimes and tps.form.callTimes.length %}
      <fieldset class="field chips chips--times">
        <legend>{{ tps.form.labels.callTime }} <span class="opt">{{ tps.form.labels.optional }}</span></legend>
        <div class="chips__row">
          {%- for t in tps.form.callTimes %}
          <label class="chip chip--small">
            <input type="radio" name="call-time" value="{{ t }}">
            <span class="chip__face">{{ timeIcon(t) | safe }}<span class="chip__text">{{ t }}</span></span>
          </label>
          {%- endfor %}
        </div>
      </fieldset>
      {%- endif %}

      {#- Netlify injects reCAPTCHA v2 here at deploy time and verifies it
          server-side before the submission is ever stored. -#}
      <div class="recaptcha-slot" data-netlify-recaptcha="true"></div>

      <div class="qf-nav">
        <button class="btn btn--secondary qf-back" type="button" data-back><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg><span class="visually-hidden">{{ tps.form.backLabel }}</span></button>
        <button class="btn btn--primary qf-submit" type="submit"><span class="qf-submit__label">{{ tps.form.submitLabel }}</span><svg class="qf-submit__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </div>
    </section>
    <p class="form-note">{{ tps.form.privacyNote }} <a href="/privacy/">Privacy policy</a>.</p>
  </form>
</div>
