{#- Before/after gallery. Each job is a drag-to-compare slider: the "before"
    layer is clipped to the handle position. The control is a real range input
    so it works with a keyboard and a screen reader for free — the visible
    handle is decorative. -#}
{%- set items = galleryItems if galleryItems else tps.gallery -%}
{%- if items.length %}
<div class="gallery" data-reveal-group>
  {%- for g in items %}
  <article class="job" data-reveal>
    <div class="job__compare" style="--pos:50%">
      <div class="job__layer">
        {% image g.afterImage, g.afterAlt, "(min-width: 1080px) 33vw, (min-width: 720px) 50vw, 100vw" %}
      </div>
      <div class="job__layer job__layer--before" aria-hidden="true">
        {% image g.beforeImage, g.beforeAlt, "(min-width: 1080px) 33vw, (min-width: 720px) 50vw, 100vw" %}
      </div>
      <span class="job__tag job__tag--before" aria-hidden="true">Before</span>
      <span class="job__tag job__tag--after" aria-hidden="true">After</span>
      <span class="job__handle" aria-hidden="true"><i></i></span>
      <input class="job__range" type="range" min="0" max="100" value="50" step="1"
             aria-label="Drag to compare before and after: {{ g.title }}">
    </div>
    <div class="job__body">
      <h3>{{ g.title }}</h3>
      <p>{{ g.caption }}</p>
      <p class="job__meta">
        {%- if tps.serviceBySlug[g.service] %}<a href="{{ tps.serviceBySlug[g.service].url }}">{{ tps.serviceBySlug[g.service].name }}</a>{% endif -%}
        {%- if tps.serviceBySlug[g.service] and tps.areaBySlug[g.area] %} &middot; {% endif -%}
        {%- if tps.areaBySlug[g.area] %}<a href="{{ tps.areaBySlug[g.area].url }}">{{ tps.areaBySlug[g.area].name }}</a>{% endif -%}
      </p>
    </div>
  </article>
  {%- endfor %}
</div>
{%- endif %}
