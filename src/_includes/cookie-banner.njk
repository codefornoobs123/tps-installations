{#- Cookie consent for GA4 (UK PECR). Only rendered when GA4 is actually set
    up. Ships hidden; main.js shows it if the visitor hasn't chosen yet, and
    loads Google Analytics ONLY after "Accept". Reject and Accept are the same
    size and weight on purpose: the ICO expects refusing to be as easy as
    agreeing. With JS off GA can't load, so there is nothing to ask. -#}
{%- if tps.analytics.provider == "ga4" and tps.analytics.ga4MeasurementId %}
<div class="consent" data-consent role="region" aria-label="Cookie choice" hidden>
  <p class="consent__text">{{ tps.analytics.consent.text }} <a href="/privacy/">Privacy policy</a>.</p>
  <div class="consent__actions">
    <button class="btn btn--secondary consent__btn" type="button" data-consent-choice="denied">{{ tps.analytics.consent.reject }}</button>
    <button class="btn btn--secondary consent__btn" type="button" data-consent-choice="granted">{{ tps.analytics.consent.accept }}</button>
  </div>
</div>
{%- endif %}
