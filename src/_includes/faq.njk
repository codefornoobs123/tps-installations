{#- Context: faqItems (required). The matching FAQPage schema is emitted by schema.njk. -#}
{%- if faqItems and faqItems.length %}
<div class="faq">
  {%- for f in faqItems %}
  <details{% if loop.first %} open{% endif %}>
    <summary>{{ f.question }}</summary>
    <div><p>{{ f.answer }}</p></div>
  </details>
  {%- endfor %}
</div>
{%- endif %}
